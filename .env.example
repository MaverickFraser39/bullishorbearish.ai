# Port the server listens on.
PORT=3000

# Where the SQLite file lives. In production this must be on a volume that
# survives restarts — the database file IS the site.
DB_PATH=./data/bullishorbearish.db

# Public origin, used for canonical URLs, the sitemap and share links.
SITE_URL=https://bullishorbearish.fly.dev

# Salt for the anonymous voter fingerprint (IP + user agent). Set a long random
# string in production and keep it stable — changing it lets everyone vote
# again. Generate one with:  node -e "console.log(crypto.randomUUID())"
VOTE_SALT=change-me-before-deploying

# Shared secret for the moderation endpoints. With this unset the admin routes
# refuse everything, so an unconfigured deploy is closed rather than open.
ADMIN_TOKEN=

# --- Posting board activity to X (entirely optional) -------------------------
# With these unset the site runs normally and logs what it would have posted.
# Create an app at https://developer.x.com with Read and Write permission, then
# generate an access token and secret for the account that should post.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Minimum gap between posts. Votes for the same company coalesce into one
# pending update, so this is the real ceiling on posting volume. X's free tier
# allows roughly 500 posts a month; 15 minutes keeps you well inside it.
ANNOUNCE_INTERVAL_MS=900000

# Set to "false" to stop posting without removing the credentials.
ANNOUNCE_ENABLED=true
