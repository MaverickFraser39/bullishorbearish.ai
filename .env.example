# Port the server listens on.
PORT=3000

# Salt used to derive the anonymous voter fingerprint (IP + user agent).
# Set this to a long random string in production and keep it stable --
# changing it lets everyone vote again. Generate one with:
#   node -e "console.log(crypto.randomUUID())"
VOTE_SALT=change-me-before-deploying

# Where the SQLite file lives.
DB_PATH=./data/bullishorbearish.db
